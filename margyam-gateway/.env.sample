# Server configuration
NODE_ENV=development
PORT=3000
SERVICE_NAME=margyam-gateway
LOG_LEVEL=debug

# CORS settings
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# JWT secret key
JWT_SECRET=jwtsecret
JWT_EXPIRATION=7d

# Database URL
DATABASE_URL=mongodb://localhost:27017/margyam_gateway

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# gRPC service locations
ASTRO_GRPC_ADDRESS=localhost:50051
LEDGER_GRPC_ADDRESS=localhost:50052

# Firebase push notifications
FCM_PROJECT_ID=firebase-project-id
